# Copie para .env (local) ou cadastre como Secrets no GitHub Actions.
# NUNCA comite os valores reais.

# Instagram Graph API
IG_USER_ID=            # id numérico da conta Instagram Business/Creator
IG_ACCESS_TOKEN=       # token de longa duração (renovar a cada ~60 dias)

# Base da API. Caminho novo (sem Página do Facebook) é o padrão:
#   https://graph.instagram.com/v21.0
# Caminho clássico (via Página do Facebook):
#   https://graph.facebook.com/v21.0
GRAPH_BASE=https://graph.instagram.com/v21.0

# URL pública base das mídias (a Graph API baixa a imagem/vídeo daqui).
# Ex.: https://raw.githubusercontent.com/<owner>/<repo-publico>/<branch>
MEDIA_BASE_URL=

# Telegram (aprovação "só aceite")
TELEGRAM_BOT_TOKEN=    # token do bot criado no @BotFather
TELEGRAM_CHAT_ID=      # seu chat id (descubra em SETUP.md)

# 1 = exige aprovação no Telegram antes de publicar (padrão)
# 0 = publica direto no horário agendado, sem aprovação
REQUIRE_APPROVAL=1
